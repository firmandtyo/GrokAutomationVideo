{
  "manifest_version": 3,
  "name": "Grok Automation - Auto Grok on Grok.com",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "Auto Grok your prompts at scale. Batch generate and auto-download videos and images on grok.com.",
  "action": {
    "default_title": "Grok Automation"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://grok.com/*",
        "*://*.grok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "*://grok.com/*",
    "*://*.grok.com/*"
  ],
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "*://grok.com/*"
      ]
    }
  ]
}